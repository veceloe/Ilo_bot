# AI Providers
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook
BOT_USERNAME=your_bot_username

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_bot_architect
REDIS_URL=redis://localhost:6379/0

# Deployment Services
TIMEWEB_API_KEY=your_timeweb_api_key
TIMEWEB_PROJECT_ID=your_project_id
BOTFATHER_TOKEN=your_botfather_token

# Security
JWT_SECRET_KEY=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here
API_SECRET_KEY=your_api_secret_key

# Application Settings
DEBUG=True
LOG_LEVEL=INFO
MAX_BOT_GENERATION_TIME=300
MAX_REQUIREMENTS_ITERATIONS=5

# External Services
WEB_SEARCH_API_KEY=your_web_search_api_key
PAYMENT_PROVIDER_KEY=your_payment_key

# File Storage
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=txt,pdf,docx,jpg,png

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100

# Monitoring
SENTRY_DSN=your_sentry_dsn
METRICS_ENABLED=True